#VRML V2.0 utf8
# Dimensionally-accurate PLACEHOLDER model for onsemi QRE1113GR (no real
# manufacturer STEP/WRL model is bundled with KiCad or available in this
# environment). Body: 4.6 x 3.4mm footprint, 1.75mm nominal height
# (datasheet gives pad/lead dimensions but no explicit body height; 1.75mm
# is a reasonable estimate for this class of small molded reflective-sensor
# package, NOT a manufacturer-verified figure).
#
# UNITS: this project's sibling WRL (n20.3dshapes/N20_Motor_Encoder.wrl) is
# authored at 1 unit = 2.54mm (tenths of an inch) -- confirmed against its
# own values (3.9370 * 2.54 = 10.00mm exactly). Two earlier attempts on
# THIS file used mm/25.4 (whole inches), rendering it at 1/10th intended
# size -- effectively invisible (confirmed absent in a real kicad-cli 3D
# render). All values below are real mm dimensions / 2.54. Also: all
# shapes wrapped in ONE Group{children[...]}, matching that file's
# structure.

Group { children [
    Transform {
      translation 0 0 0.3445
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.15 0.15 0.15 } }
        geometry Box { size 1.8110 1.3386 0.6890 }
      }
    }
    Transform {
      translation -0.6496 0.3543 0.01969
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.8 0.8 0.75 } }
        geometry Box { size 0.3937 0.2756 0.03937 }
      }
    }
    Transform {
      translation -0.6496 -0.3543 0.01969
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.8 0.8 0.75 } }
        geometry Box { size 0.3937 0.2756 0.03937 }
      }
    }
    Transform {
      translation 0.6496 -0.3543 0.01969
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.8 0.8 0.75 } }
        geometry Box { size 0.3937 0.2756 0.03937 }
      }
    }
    Transform {
      translation 0.6496 0.3543 0.01969
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.8 0.8 0.75 } }
        geometry Box { size 0.3937 0.2756 0.03937 }
      }
    }
] }
