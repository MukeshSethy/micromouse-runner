(footprint "QRE1113GR"
	(version 20240108)
	(generator "gen_rev6_libs")
	(layer "F.Cu")
	(descr "onsemi QRE1113GR SMT reflective object sensor, gull-wing SMD-4 (datasheet Rev 1.2.0): body 4.4-4.8 x 3.2-3.6mm, pin pitch 1.80mm (within a column) x 3.30mm (between columns). Pin 1 Anode, Pin 2 Cathode (emitter LED); Pin 3 Collector, Pin 4 Emitter (phototransistor). Authored native F.Cu (normal solder-pad-view coordinates, matching the datasheet's own bottom/solder-side pin diagram); this project's gen_pcb.place(..., flip=True) mirrors it onto B.Cu at placement time, same convention already used for TCRT5000.")
	(attr smd)
	(fp_text reference "REF**" (at 0 -2.6) (layer "F.SilkS")
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_text value "VAL" (at 0 2.6) (layer "F.Fab")
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(fp_rect (start -2.3 -1.7) (end 2.3 1.7) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_rect (start -2.9 -2.2) (end 2.9 2.2) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_line (start -2.3 -1.7) (end -1.0 -1.7) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 1.0 -1.7) (end 2.3 -1.7) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -2.3 1.7) (end -1.0 1.7) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 1.0 1.7) (end 2.3 1.7) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(pad "1" smd roundrect (at -1.65 0.9) (size 1.0 0.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "2" smd roundrect (at -1.65 -0.9) (size 1.0 0.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "3" smd roundrect (at 1.65 -0.9) (size 1.0 0.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "4" smd roundrect (at 1.65 0.9) (size 1.0 0.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(model "${KIPRJMOD}/qre1113.pretty/QRE1113GR.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
